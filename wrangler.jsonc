{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ncpa-sound",
  "compatibility_date": "2025-10-24",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ncpa-sound-crew-db",
      "database_id": "8dd5bac9-26b7-45d7-94b3-7a013ec3e880"
    },
    {
      "binding": "DB_CREW",
      "database_name": "ncpa-crew-db",
      "database_id": "3bc26aff-d41b-4d7b-bb68-7b768d02dabf"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "ncpa-events-index"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_SYNC",
        "class_name": "EventSyncRoom",
        "script_name": "ncpa-event-sync"
      }
    ]
  }
}
